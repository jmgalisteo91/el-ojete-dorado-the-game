# ==============================================================
# El Ojete Dorado: The Game · Variables de Entorno para Vercel
# ==============================================================
# Conexión con Vercel KV / Upstash Redis (Serverless Key-Value)
# Puedes añadir Vercel KV o Upstash gratis desde el Marketplace de Vercel.
# Al vincularlo a tu proyecto, Vercel inyecta automáticamente estas variables:

KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your_token_here

# O si utilizas directamente Upstash Redis:
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
